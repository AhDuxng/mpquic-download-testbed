# =============================================================================
# File        : config.env
# Project     : mpquic-download-testbed
# Description : Shared configuration, sourced by every script in common/, server/
#               and client/, and parsed by client/lib/testbed.py.
#
# Sections
#   Server   Address and SNI of the server. SERVER_PORT is the UDP port of the
#            HTTP/3 server (MPQUIC); MPTCP_PORT is the TCP port of the HTTPS
#            server (MPTCP). Both serve the same www/ directory.
#            SERVER_INSTALL_DIR holds bin/, certs/, www/ and logs/ on the
#            server. TEST_FILES lists the generated files as name:size (size
#            suffix K, M or G). CONGESTION_CONTROL is applied by both servers
#            (sender side) so the two protocols use the same algorithm.
#   Client   CLIENT_CIPHER forces the TLS cipher: 20 = ChaCha20-Poly1305 (the
#            Raspberry Pi 4 has no AES instructions), 128 = AES-128-GCM,
#            256 = AES-256-GCM, empty = picoquic default. CLIENT_DL_DIR is a RAM
#            directory so SD-card write speed never limits a download.
#   Build    picoquic is pinned to one commit for reproducibility; change it
#            deliberately and record the change.
#   Deploy   Used only by server/deploy.sh, run from a workstation.
#
# Format      : KEY="value", one per line. Keep values in double quotes; the
#               Python parser accepts no other quoting.
# =============================================================================

SERVER_IP="47.129.174.173"
SERVER_PORT="4443"
MPTCP_PORT="8443"
SERVER_SNI="mpquic.local"
SERVER_INSTALL_DIR="/data/mpquic-download-testbed/run"
TEST_FILES="file_1MB.bin:1M file_10MB.bin:10M file_50MB.bin:50M file_100MB.bin:100M"
CONGESTION_CONTROL="cubic"

CLIENT_CIPHER="20"
CLIENT_DL_DIR="/dev/shm/mpquic-dl"

PICOQUIC_REPO="https://github.com/private-octopus/picoquic.git"
PICOQUIC_COMMIT="36f49b73d532369882d97474ac018655b6739a58"

SSH_USER="ubuntu"
SSH_KEY="$HOME/.ssh/id_ed25519"
REMOTE_REPO_DIR="/data/mpquic-download-testbed"
