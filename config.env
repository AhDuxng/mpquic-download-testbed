# Shared configuration for the MPQUIC file-download experiment.
# Sourced by every script in server/, client/ and common/.

# --- Server -----------------------------------------------------------------
SERVER_IP="47.129.174.173"
SERVER_PORT="4443"                 # UDP. Must be open in the AWS Security Group.
SERVER_SNI="mpquic.local"          # Name put in the self-signed cert and sent as SNI.
SERVER_INSTALL_DIR="/opt/mpquic"   # Where the server keeps bin/, certs/, www/, logs/.

# Test files generated on the server (name:size, size accepted by `head -c`/dd style: K, M, G).
TEST_FILES="file_1MB.bin:1M file_10MB.bin:10M file_50MB.bin:50M file_100MB.bin:100M"

# --- Client (Raspberry Pi 4) ------------------------------------------------
# Cipher forced by the client: 20 = ChaCha20-Poly1305. The Pi 4 (BCM2711) has no
# AES instructions, so AES-GCM in software can make the CPU the bottleneck.
# Other values: 128 = AES-128-GCM, 256 = AES-256-GCM, empty = picoquic default.
CLIENT_CIPHER="20"
# Downloads go to RAM so the SD card write speed is not the bottleneck.
CLIENT_DL_DIR="/dev/shm/mpquic-dl"

# --- picoquic build -----------------------------------------------------------
PICOQUIC_REPO="https://github.com/private-octopus/picoquic.git"
# Pinned commit for reproducibility (master on 2026-11-12). Change deliberately, not silently.
PICOQUIC_COMMIT="36f49b73d532369882d97474ac018655b6739a58"

# --- Deploy (only used by server/deploy.sh, run from your laptop) -------------
SSH_USER="ubuntu"
SSH_KEY="$HOME/.ssh/your-aws-key.pem"
